---
import Layout from "../layouts/Layout.astro";
import { sanityClient, urlFor } from "../sanity/client";

interface Product {
  _id: string;
  name: string;
  slug: { current: string };
  images: any[];
  price: number;
  description: string;
}

let products: Product[] = [];

try {
  products = await sanityClient.fetch<Product[]>(
    `*[_type == "product"] | order(_createdAt desc) {
      _id,
      name,
      slug,
      images,
      price,
      description
    }`
  );
} catch (e) {
  console.error("Failed to fetch products:", e);
}
---

<Layout title="Tæki og Tól Til Leigu — Products">
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
        Hvaða tæki og tól eru til leigu?
      </h1>
      <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">
        
      </p>
    </div>

    {products.length === 0 ? (
      <div class="text-center py-20">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gray-100 mb-6">
          <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
          </svg>
        </div>
        <h2 class="text-xl font-semibold text-gray-700 mb-2">Úps! Hvorki tæki né tól í augnablikinu!</h2>
        <p class="text-gray-500 mb-6">
        </p>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map((product) => (
          <article class="group bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-shadow duration-300">
            <div class="aspect-square overflow-hidden bg-gray-100 relative carousel" data-index="0">
              {product.images?.length ? (
                <>
                  <div class="carousel-track flex h-full transition-transform duration-300 ease-out">
                    {product.images.map((img: any, i: number) => (
                      <img
                        src={urlFor(img).width(600).height(600).url()}
                        alt={`${product.name} — mynd ${i + 1}`}
                        class="w-full h-full object-cover flex-shrink-0"
                        data-slide={i}
                        loading="lazy"
                      />
                    ))}
                  </div>
                  {product.images.length > 1 && (
                    <>
                      <button
                        class="carousel-prev absolute left-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white rounded-full p-1.5 shadow-md transition-colors z-10"
                        aria-label="Fyrri mynd"
                      >
                        <svg class="w-5 h-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                        </svg>
                      </button>
                      <button
                        class="carousel-next absolute right-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white rounded-full p-1.5 shadow-md transition-colors z-10"
                        aria-label="Næsta mynd"
                      >
                        <svg class="w-5 h-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                      </button>
                      <div class="absolute bottom-2 left-1/2 -translate-x-1/2 flex gap-1.5 z-10">
                        {product.images.map((_: any, i: number) => (
                          <span
                            class:list={[
                              "w-2 h-2 rounded-full transition-colors carousel-dot",
                              i === 0 ? "bg-white" : "bg-white/50",
                            ]}
                            data-dot={i}
                          />
                        ))}
                      </div>
                    </>
                  )}
                </>
              ) : (
                <div class="w-full h-full flex items-center justify-center text-gray-300">
                  <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
              )}
            </div>
            <div class="p-5">
              <h3 class="text-lg font-semibold text-gray-900 mb-1">
                {product.name}
              </h3>
              <p class="text-2xl font-bold text-gray-900 mb-3">
                {product.price?.toLocaleString("is-IS")} kr.
              </p>
              <p class="text-sm text-gray-600 line-clamp-3">
                {product.description}
              </p>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
</Layout>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  document.querySelectorAll('.carousel').forEach((carousel) => {
    const track = carousel.querySelector<HTMLDivElement>('.carousel-track');
    const slides = carousel.querySelectorAll<HTMLImageElement>('[data-slide]');
    const dots = carousel.querySelectorAll<HTMLSpanElement>('[data-dot]');
    if (!track || slides.length <= 1) return;

    let current = 0;
    let startX = 0;
    let currentTranslate = 0;
    let isDragging = false;

    function getWidth() {
      return carousel.getBoundingClientRect().width;
    }

    function goTo(index: number, animate = true) {
      current = index;
      currentTranslate = -current * getWidth();
      track.style.transition = animate ? 'transform 300ms ease-out' : 'none';
      track.style.transform = `translateX(${currentTranslate}px)`;
      dots.forEach((d, i) => {
        d.classList.toggle('bg-white', i === index);
        d.classList.toggle('bg-white/50', i !== index);
      });
    }

    carousel.querySelector('.carousel-prev')?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (current > 0) goTo(current - 1);
    });

    carousel.querySelector('.carousel-next')?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (current < slides.length - 1) goTo(current + 1);
    });

    // Touch swipe with real-time tracking
    carousel.addEventListener('touchstart', (e) => {
      isDragging = true;
      startX = (e as TouchEvent).touches[0].clientX;
      track.style.transition = 'none';
    }, { passive: true });

    carousel.addEventListener('touchmove', (e) => {
      if (!isDragging) return;
      const x = (e as TouchEvent).touches[0].clientX;
      const diff = x - startX;
      const offset = -current * getWidth() + diff;
      track.style.transform = `translateX(${offset}px)`;
    }, { passive: true });

    carousel.addEventListener('touchend', (e) => {
      if (!isDragging) return;
      isDragging = false;
      const endX = (e as TouchEvent).changedTouches[0].clientX;
      const diff = endX - startX;
      const threshold = getWidth() * 0.25;

      if (diff < -threshold && current < slides.length - 1) {
        goTo(current + 1);
      } else if (diff > threshold && current > 0) {
        goTo(current - 1);
      } else {
        goTo(current);
      }
    }, { passive: true });
  });
</script>
